OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Configuration
OPENAI_MODEL=gpt-4-vision-preview

# OpenAI-Format API Configuration (for compatible endpoints)
# Configure these for custom endpoints like Ollama, LM Studio, Together AI, etc.
OPENAI_FORMAT_API_URL=http://localhost:11434/v1
OPENAI_FORMAT_API_KEY=optional-api-key-if-required
OPENAI_FORMAT_MODEL=llava:latest

# Alternative provider examples (uncomment and configure as needed)
# OPENAI_FORMAT_API_URL=http://localhost:1234/v1  # LM Studio
# OPENAI_FORMAT_MODEL=local-model
# OPENAI_FORMAT_API_URL=https://api.together.xyz/v1  # Together AI
# OPENAI_FORMAT_MODEL=meta-llama/Llama-2-7b-chat-hf
