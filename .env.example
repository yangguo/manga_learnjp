OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Configuration
OPENAI_MODEL=gpt-4-vision-preview

# OpenAI Base URL (optional)
# Set this to use an OpenAI-compatible endpoint instead of the official API.
# A base URL with a version segment (/v1, /api/v3, ...) is used as-is; a bare
# host gets /v1 appended. Examples:
#   OPENAI_BASE_URL=https://api.openai.com/v1            # official (default)
#   OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3   # Volcengine ARK (doubao)
#   OPENAI_BASE_URL=https://your-proxy.example.com       # bare host -> .../v1/chat/completions
# OPENAI_BASE_URL=

# Per-batch analysis fetch timeout in milliseconds (default 120000 = 120s).
# Raise for very slow endpoints, lower to fail faster. Must stay under the
# 280s client timeout and the 300s route maxDuration with your batch count.
# ANALYSIS_FETCH_TIMEOUT_MS=120000

# OpenAI-Format API Configuration (for compatible endpoints)
# Configure these for custom endpoints like Ollama, LM Studio, Together AI, etc.
# Note: OPENAI_BASE_URL above routes the built-in OpenAIService to a compatible
# endpoint. Use these OPENAI_FORMAT_* vars only when you want a separate provider
# entry selectable in the UI.
OPENAI_FORMAT_API_URL=http://localhost:11434/v1
OPENAI_FORMAT_API_KEY=optional-api-key-if-required
OPENAI_FORMAT_MODEL=llava:latest

# Alternative provider examples (uncomment and configure as needed)
# OPENAI_FORMAT_API_URL=http://localhost:1234/v1  # LM Studio
# OPENAI_FORMAT_MODEL=local-model
# OPENAI_FORMAT_API_URL=https://api.together.xyz/v1  # Together AI
# OPENAI_FORMAT_MODEL=meta-llama/Llama-2-7b-chat-hf
